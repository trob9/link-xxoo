DATABASE_URL="file:./dev.db"

# --- Auth.js (Discord OAuth) ---
# Generate with: openssl rand -base64 33
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Create a Discord application at https://discord.com/developers/applications
# OAuth2 redirect URI: <AUTH_URL>/api/auth/callback/discord
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# Create a Google OAuth client at https://console.cloud.google.com/auth/clients
# Authorized JavaScript origin: <AUTH_URL>
# Authorized redirect URI:      <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
