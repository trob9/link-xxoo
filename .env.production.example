# Copy to .env.production on the deploy host (mini-PC) and fill in real values.
# Never commit the filled-in version.

# DATABASE_URL is set inside the Dockerfile to file:/app/data/prod.db (a
# volume-backed path) — no need to set it here unless you're moving to Postgres.

AUTH_SECRET=""
