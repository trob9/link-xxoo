# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real secrets, never commit these...
.env
.env.local
.env.production
.env*.local
# ...but the checked-in templates (placeholders only) should be tracked.
!.env.example
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local sqlite db
*.db
*.db-journal

# vendor-provided AI assistant skill bundles (not project code)
/.agents/
/.claude/
/.windsurf/
skills-lock.json

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Refine-pass notes — local working memory, not part of the product
.refine/

# e2e scratch: the throwaway sqlite file the Playwright global-setup builds
/e2e/.tmp/
