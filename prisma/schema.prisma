// Prisma schema for link.xxoo.ooo
// Auth is JWT-based (Discord + Google OAuth via Auth.js) — no Account/Session
// tables needed, we just upsert a User row keyed by (provider,
// providerAccountId) on sign-in.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id String @id @default(cuid())

  // Identity is the (provider, id-at-that-provider) pair, not the email.
  // Signing in with Google therefore creates its own account even when the
  // email matches an existing Discord user — deliberate, so a compromised
  // mailbox can never reach someone else's profile.
  provider          String
  providerAccountId String
  providerAvatar    String?

  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile Profile?

  @@unique([provider, providerAccountId])
}

model Profile {
  id       String @id @default(cuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  username String @unique

  displayName      String
  bio              String?
  avatarUrl        String? // Discord-provided avatar (fallback when no custom upload)
  avatarImage      Bytes? // server-converted WebP bytes from a user upload
  avatarShape      String  @default("circle") // "circle" | "rounded" | "square"
  avatarEnabled    Boolean @default(true)
  seoTitle         String?
  seoDescription   String?
  sensitiveContent Boolean @default(false)

  // The live look is themePreset + themeConfig, in that order: themeConfig is
  // a JSON object spread over the preset's config, so it works whether it
  // holds a couple of overrides (how it was first used) or a whole theme (how
  // the editor writes it now). activeThemeId records which saved theme the
  // live look came from — a UI hint for "which card is selected", not a
  // second source of truth for the colours.
  themePreset   String  @default("dawn")
  themeConfig   String?
  activeThemeId String?

  socialLinks  SocialLink[]
  links        Link[]
  customThemes CustomTheme[]
  views        ProfileView[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A theme the owner designed and named. Real rows rather than a JSON array on
// Profile because each one is independently created, renamed, edited and
// deleted, and needs a stable id to be re-selected later — an array in a blob
// would mean hand-rolling ids and rewriting every theme to change one.
model CustomTheme {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name      String

  background        String
  surface           String
  ink               String
  inkMuted          String
  accent            String
  accentInk         String
  buttonStyle       String
  backgroundPattern String
  displayFont       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
}

model SocialLink {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  platform  String
  url       String
  order     Int     @default(0)

  @@index([profileId])
}

model Link {
  id           String  @id @default(cuid())
  profileId    String
  profile      Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title        String
  url          String
  icon         String?
  thumbnailUrl String?
  enabled      Boolean @default(true)
  featured     Boolean @default(false)
  order        Int     @default(0)

  startsAt DateTime?
  endsAt   DateTime?

  clickCount Int @default(0)

  clicks ClickEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId, order])
}

// One row per page view of a public profile. Clicks were already recorded, so
// without this the dashboard could show "142 clicks" but never answer "out of
// how many visits" — a click-through rate needs both halves.
model ProfileView {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([profileId, createdAt])
}

model ClickEvent {
  id        String   @id @default(cuid())
  linkId    String
  link      Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  referrer  String?

  @@index([linkId, createdAt])
}
